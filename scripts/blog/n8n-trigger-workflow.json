{
  "name": "JW Blog — trigger generate-blog action",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1,3,5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Mon/Wed/Fri 9:00 AM Central",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/Tim-s-Dev/jw-site-restyle/actions/workflows/generate-blog.yml/dispatches",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ref\": \"main\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": false,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "2",
      "name": "Dispatch generate-blog.yml",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    }
  ],
  "connections": {
    "Mon/Wed/Fri 9:00 AM Central": {
      "main": [
        [
          {
            "node": "Dispatch generate-blog.yml",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/Chicago",
    "executionOrder": "v1"
  }
}
