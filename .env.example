# JourneyWell Studio Booking — environment variables
# Copy to .env.local for local dev (gitignored). In production these are set in
# the Vercel project (Settings → Environment Variables).

# ---- Stripe ----
# Use sk_test_/pk_test_ for testing, sk_live_/pk_live_ for production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- GoHighLevel (LeadConnector) — Private Integration Token + JourneyWell location ----
GHL_PIT=pit-xxxxxxxx
GHL_LOCATION_ID=oHRQ5zrDv5a4WxPsJS5c
GHL_STUDIO_CALENDAR_ID=IerKzSnVIV4ukFpP6HDo
GHL_STUDIO_ASSIGNED_USER_ID=8FZiz7vRq3Gp9TCO6UdU

# ---- Booking config ----
BOOKING_TZ=America/Chicago
# live = real Stripe charges | mock = skip Stripe (local UI testing only)
PAYMENTS_MODE=live
# live = create real GHL appointment | dry = simulate, no calendar write (demos/testing)
BOOKING_MODE=live
